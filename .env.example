# Copia este archivo a .env (está en .gitignore). Todo es opcional.

# Puerto del servidor propio (server/index.js).
PORT=3000

# Señalización WebRTC en el propio servidor (ruta /peer). Déjalo en 1 en producción.
# Sin esta variable el front usa la nube gratuita de PeerJS.
VITE_PEER_SELF=1

# Usuario de Letterboxd para la tira de películas (RSS público). Por defecto csarr911.
LETTERBOXD_USER=csarr911

# "Sonando ahora" real de Spotify. Authorization Code una vez, guardar el refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
